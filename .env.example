# La identidad y los datos de negocio se consultan exclusivamente en NestJS.
# Ruta relativa para cookies del mismo origen. Vite redirige /api hacia API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:3000

# Google OAuth 2.0 Web Client ID
# Configura tu Client ID generado en Google Cloud Console (Tipo: Aplicación Web)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
